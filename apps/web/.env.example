# Copy this file to .env.local to sign in for real. Never commit .env.local.
# Without these three values the app runs on sample data (src/api/mockServer.js).

# The Express API: http://localhost:3000 on your computer, https://khatet.onrender.com when deployed.
VITE_API_URL=http://localhost:3000

# Supabase dashboard > Project Settings > API Keys (the publishable key, never the secret key).
# Use the same Supabase project as the API's SUPABASE_URL.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
