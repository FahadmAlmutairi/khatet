// Khatet database schema (docs/data-model.md).
// Sprint 1 tables: users, projects, project members, invitations, notifications (TF-04),
// and tasks with their assignees (US-13 to US-18, US-21).
// Change it only through a migration: npm run db:migrate -- --name what_changed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the running API
  directUrl = env("DIRECT_URL")   // direct (session) connection, used by migrations
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum TaskAccess {
  VIEW_ONLY
  EDIT_ASSIGNED
  EDIT_ALL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  INVITATION
  TASK_ASSIGNED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  READY_FOR_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// A Khatet account, linked to one Supabase Auth user.
model User {
  id                String    @id @default(uuid()) @db.Uuid
  authId            String    @unique @map("auth_id") @db.Uuid
  email             String    @unique
  // Null until the new user chooses one (US-01). Lowercase, 3 to 20 letters, numbers or underscores.
  username          String?   @unique
  usernameChangedAt DateTime? @map("username_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  createdProjects     Project[]       @relation("ProjectCreator")
  memberships         ProjectMember[]
  invitationsReceived Invitation[]    @relation("InvitedUser")
  invitationsSent     Invitation[]    @relation("InvitedBy")
  notifications       Notification[]  @relation("NotificationRecipient")
  notificationsCaused Notification[]  @relation("NotificationActor")
  createdTasks        Task[]          @relation("TaskCreator")
  taskAssignments     TaskAssignee[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   @default("")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy     User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members       ProjectMember[]
  invitations   Invitation[]
  notifications Notification[]
  tasks         Task[]

  @@map("projects")
}

// A user's membership in one project. The owner has role OWNER and full access.
model ProjectMember {
  projectId  String      @map("project_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  role       ProjectRole @default(MEMBER)
  taskAccess TaskAccess  @default(EDIT_ASSIGNED) @map("task_access")
  joinedAt   DateTime    @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// The owner's invitation to a registered user. Accepting creates a
// ProjectMember with EDIT_ASSIGNED.
model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  invitedUserId String           @map("invited_user_id") @db.Uuid
  invitedById   String           @map("invited_by_id") @db.Uuid
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  respondedAt   DateTime?        @map("responded_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedUser   User           @relation("InvitedUser", fields: [invitedUserId], references: [id])
  invitedBy     User           @relation("InvitedBy", fields: [invitedById], references: [id])
  notifications Notification[]

  @@index([projectId, status])
  @@index([invitedUserId, status])
  @@map("invitations")
}

// An in-app update for one user.
model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  projectId    String           @map("project_id") @db.Uuid
  actorId      String?          @map("actor_id") @db.Uuid
  invitationId String?          @map("invitation_id") @db.Uuid
  taskId       String?          @map("task_id") @db.Uuid
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// A unit of work on the board (US-13 to US-18, US-21).
// Rules the API enforces: a task has at least one assignee, every assignee is a
// project member, and isBlocked can be true only while status is IN_PROGRESS.
// The link to a phase is added with phases in Sprint 3.
model Task {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  title         String
  description   String        @default("")
  status        TaskStatus    @default(TODO)
  priority      TaskPriority?
  isBlocked     Boolean       @default(false) @map("is_blocked")
  blockedReason String?       @map("blocked_reason")
  dueDate       DateTime?     @map("due_date") @db.Date
  // Whole-number order within each status column: 1, 2, 3, ... (decided 5 Oct 2026).
  position      Int
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id])
  assignees     TaskAssignee[]
  notifications Notification[]

  @@index([projectId, status, position])
  @@index([projectId, dueDate])
  @@map("tasks")
}

// Links a task to each assigned project member.
model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}
