# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# Supabase dashboard > Connect > ORMs > Prisma.
# Pooled connection (port 6543) used by the running API:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session connection (port 5432) used by migrations:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Tests: the same session connection as DIRECT_URL with schema=test added
# (&schema=test, or ?schema=test if there is no "?" yet). Everything in it is deleted.
TEST_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?schema=test"

# Supabase dashboard > Project Settings > API Keys (the publishable key, never the secret key).
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Sites allowed to call the API from the browser, comma-separated.
CORS_ORIGINS="http://localhost:5173,https://khatet.vercel.app"

# Development only: lets you call the API as the seed users with "Bearer dev:<authId>:<email>".
# Leave it false, and never set it on Render.
DEV_FAKE_AUTH=false
